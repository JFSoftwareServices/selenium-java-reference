<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jfsoftwareservices</groupId>
    <artifactId>selenium-java-automation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>selenium-java-automation</name>

    <description>
        Java + Selenium 4 UI/API automation framework demonstrating Page Object Model,
        API-based authentication, a TestNG data-driven suite, Selenium Grid execution
        via Docker Compose, and CI/CD via Jenkins/GitHub Actions to AWS EC2.
    </description>

    <url>https://github.com/JFSoftwareServices/selenium-java-automation</url>

    <licenses>
        <license>
            <name>ISC License</name>
            <url>https://opensource.org/licenses/ISC</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Jide</name>
            <organization>JFSoftwareServices</organization>
        </developer>
    </developers>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions -->
        <selenium.version>4.49.0</selenium.version>
        <webdrivermanager.version>6.3.4</webdrivermanager.version>
        <testng.version>7.10.2</testng.version>
        <restassured.version>5.5.0</restassured.version>
        <assertj.version>3.26.3</assertj.version>
        <dotenv.version>3.1.0</dotenv.version>
        <slf4j.version>2.0.16</slf4j.version>

        <!-- Plugin versions -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>

        <!-- Runtime configuration, overridable via -D or environment -->
        <suite.thread.count>4</suite.thread.count>
    </properties>

    <dependencies>

        <!-- Selenium WebDriver -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- WebDriverManager -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>

        <!-- TestNG -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- REST Assured -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${restassured.version}</version>
        </dependency>

        <!-- AssertJ -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
        </dependency>

        <!-- dotenv -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

    </dependencies>

    <build>

        <plugins>

            <!-- Maven Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
            </plugin>

        </plugins>

    </build>

    <!-- ============================================================= -->
    <!-- Maven Profiles                                                 -->
    <!-- ============================================================= -->

    <profiles>

        <!-- ========================================================= -->
        <!-- DEFAULT: Run parallel suite followed by serial suite      -->
        <!-- ========================================================= -->

        <profile>
            <id>full</id>

            <!-- Automatically active when no other profile is selected -->
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>

            <build>
                <plugins>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven.surefire.plugin.version}</version>

                        <configuration>
                            <testFailureIgnore>false</testFailureIgnore>
                        </configuration>

                        <executions>

                            <!-- Parallel suite -->
                            <execution>
                                <id>parallel-suite</id>
                                <phase>test</phase>

                                <goals>
                                    <goal>test</goal>
                                </goals>

                                <configuration>
                                    <suiteXmlFiles>
                                        <suiteXmlFile>
                                            testng-parallel.xml
                                        </suiteXmlFile>
                                    </suiteXmlFiles>

                                    <properties>
                                        <property>
                                            <name>dataproviderthreadcount</name>
                                            <value>${suite.thread.count}</value>
                                        </property>
                                    </properties>
                                </configuration>
                            </execution>

                            <!-- Serial suite -->
                            <execution>
                                <id>serial-suite</id>
                                <phase>test</phase>

                                <goals>
                                    <goal>test</goal>
                                </goals>

                                <configuration>
                                    <suiteXmlFiles>
                                        <suiteXmlFile>
                                            testng-serial.xml
                                        </suiteXmlFile>
                                    </suiteXmlFiles>
                                </configuration>
                            </execution>

                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>


        <!-- ========================================================= -->
        <!-- PARALLEL ONLY                                              -->
        <!-- ========================================================= -->

        <profile>
            <id>parallel</id>

            <build>
                <plugins>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven.surefire.plugin.version}</version>

                        <configuration>
                            <testFailureIgnore>false</testFailureIgnore>

                            <suiteXmlFiles>
                                <suiteXmlFile>
                                    testng-parallel.xml
                                </suiteXmlFile>
                            </suiteXmlFiles>

                            <properties>
                                <property>
                                    <name>dataproviderthreadcount</name>
                                    <value>${suite.thread.count}</value>
                                </property>
                            </properties>

                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>


        <!-- ========================================================= -->
        <!-- SERIAL ONLY                                                -->
        <!-- ========================================================= -->

        <profile>
            <id>serial</id>

            <build>
                <plugins>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven.surefire.plugin.version}</version>

                        <configuration>
                            <testFailureIgnore>false</testFailureIgnore>

                            <suiteXmlFiles>
                                <suiteXmlFile>
                                    testng-serial.xml
                                </suiteXmlFile>
                            </suiteXmlFiles>

                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>

    </profiles>

</project>