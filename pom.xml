<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jfsoftwareservices</groupId>
    <artifactId>selenium-java-automation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>selenium-java-automation</name>
    <description>
        Java + Selenium 4 UI/API automation framework demonstrating Page Object Model,
        API-based authentication, a TestNG data-driven suite, Selenium Grid execution
        via Docker Compose, and CI/CD via Jenkins/GitHub Actions to AWS EC2.
    </description>
    <url>https://github.com/JFSoftwareServices/selenium-java-automation</url>

    <licenses>
        <license>
            <name>ISC License</name>
            <url>https://opensource.org/licenses/ISC</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Jide</name>
            <organization>JFSoftwareServices</organization>
        </developer>
    </developers>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions -->
        <selenium.version>4.27.0</selenium.version>
        <webdrivermanager.version>5.9.2</webdrivermanager.version>
        <testng.version>7.10.2</testng.version>
        <restassured.version>5.5.0</restassured.version>
        <assertj.version>3.26.3</assertj.version>
        <dotenv.version>3.1.0</dotenv.version>
        <slf4j.version>2.0.16</slf4j.version>

        <!-- Plugin versions -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>

        <!-- Runtime configuration, overridable via -D or environment (Docker/CI) -->
        <suite.thread.count>4</suite.thread.count>
    </properties>

    <dependencies>
        <!-- Selenium WebDriver -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- Manages local browser driver binaries; bypassed automatically when
             pointed at a remote Selenium Grid (see DriverFactory). -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>

        <!-- Test runner: TestNG, for data-driven providers, groups, and
             XML-suite-controlled parallel/serial execution. -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- REST Assured, used for API-based authentication and the API test suite. -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${restassured.version}</version>
        </dependency>

        <!-- Fluent assertions -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
        </dependency>

        <!-- .env support, mirrors the original dotenv/config usage -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
            </plugin>

            <!--
              Two Surefire executions bound to the same `test` phase, run in
              declaration order. This reproduces the original npm script
              `test:parallel && test:serial`:
                1. testng-parallel.xml - independent journeys, thread-count driven
                2. testng-serial.xml   - account-mutating journeys, forced single-threaded
              `mvn test` alone runs both; CI and Docker Compose call `mvn test` as one step.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <executions>
                    <execution>
                        <id>parallel-suite</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <suiteXmlFiles>
                                <suiteXmlFile>testng-parallel.xml</suiteXmlFile>
                            </suiteXmlFiles>
                            <properties>
                                <property>
                                    <name>dataproviderthreadcount</name>
                                    <value>${suite.thread.count}</value>
                                </property>
                            </properties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>serial-suite</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <suiteXmlFiles>
                                <suiteXmlFile>testng-serial.xml</suiteXmlFile>
                            </suiteXmlFiles>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <testFailureIgnore>false</testFailureIgnore>
                    <!-- Individual runs (IntelliJ, `mvn test -Dtest=...`) still work
                         normally; these executions only govern the full-suite `mvn test`. -->
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>