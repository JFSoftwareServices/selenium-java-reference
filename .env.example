# Copy this file to .env and fill in real values.
# .env is git-ignored.

BASE_URL=

TEST_USER_EMAIL=your-test-account@example.com
TEST_USER_PASSWORD=your-test-account-password


# Default browser.
# Can be overridden by environment variables or system properties.
TEST_BROWSER=chrome


# Leave blank for local runs.
# WebDriverManager launches a local browser when GRID_URL is blank.
# Can be overridden to use Selenium Grid.
GRID_URL=


# false (default) for a visible local browser.
# Can be overridden to run the browser in headless mode.
HEADLESS=false