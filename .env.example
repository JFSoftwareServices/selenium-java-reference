# Copy this file to .env and fill in real values. .env is git-ignored.

BASE_URL=https://rahulshettyacademy.com
TEST_USER_EMAIL=your-test-account@example.com
TEST_USER_PASSWORD=your-test-account-password

# Local/IntelliJ default: chrome. Docker/CI can override with firefox too.
TEST_BROWSER=chrome

# Leave blank for local runs (WebDriverManager launches a real browser).
# Docker Compose sets this automatically to point at the Grid hub.
GRID_URL=

# true in Docker/CI, false (default) for a visible local browser in IntelliJ.
HEADLESS=false